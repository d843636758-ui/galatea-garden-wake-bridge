[Unit]
Description=Galatea Garden 唤醒桥
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=garden-wake
Group=garden-wake
WorkingDirectory=/opt/galatea-garden-wake-bridge
EnvironmentFile=/etc/galatea-garden-wake.env
ExecStart=/usr/bin/node /opt/galatea-garden-wake-bridge/dist/cli.js run
Restart=no
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
