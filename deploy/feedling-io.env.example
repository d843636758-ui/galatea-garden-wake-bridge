# Garden SSE credential. Store the real value as a protected deployment secret.
GARDEN_MACHINE_TOKEN=replace-with-garden-machine-token
GARDEN_BASE_URL=https://wake-v1.abysslumina.com

# Existing IO/Feedling resident credential. This is a separate secret from the
# Garden machine token; never copy either value into the repository.
FEEDLING_API_URL=https://api.feedling.app
FEEDLING_API_KEY=replace-with-feedling-api-key
FEEDLING_GARDEN_INJECTOR_TIMEOUT_MS=15000

# Resolve this path to the checked-out repository on the bridge host.
GARDEN_INJECTOR_EXECUTABLE=node
GARDEN_INJECTOR_ARGS_JSON='["/absolute/path/to/galatea-garden-wake-bridge/integrations/feedling-io/inject.mjs"]'
GARDEN_INJECTOR_WORKING_DIRECTORY=/absolute/path/to/galatea-garden-wake-bridge
GARDEN_LOG_LEVEL=info
